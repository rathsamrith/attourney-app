DATABASE_URL="postgresql://attest:attest@localhost:5432/attest?schema=public"
REDIS_URL="redis://localhost:6379"
OIDC_ISSUER="http://localhost:8080/realms/attest"
OIDC_AUDIENCE="attest-api"
WEB_ORIGIN="http://localhost:5173"
PORT=3000
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTE_ENCRYPTION_KEY=""
STORAGE_DIR="./storage"
ERRATA_WINDOW_DAYS=30
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="attest-dev-livekit-secret-change-me-0000"
# OIDC_JWKS_URI overrides where the backend fetches signing keys (e.g. an internal URL).
# OIDC_JWKS_URI="http://keycloak:8080/realms/attest/protocol/openid-connect/certs"
# Sign-in flow: "otp" = emailed one-time code (default), "oidc" = Keycloak password.
AUTH_MODE="otp"
# Show the seeded test accounts on the sign-in screen (defaults to on when AUTH_MODE=otp).
SHOW_TEST_CREDENTIALS="true"
OTP_JWT_SECRET=""
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Attest <no-reply@attest.local>"
